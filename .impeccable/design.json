  "components": [
    {
      "name": "Celda de categoría",
      "kind": "card",
      "refersTo": "category-tile",
      "description": "Celda del bento con índice, nombre en display y cantidad.",
      "html": "<a class=\"ds-tile\" href=\"#\"><span class=\"ds-tile-n\">01</span><span><span class=\"ds-tile-name\">Entradas</span><span class=\"ds-tile-count\">6 platos</span></span></a>",
      "css": ".ds-tile{--ink:#2a2622;--carta-terra:#a43f22;--carta-blush:#f3d2c6;color:var(--ink);font-family:Schibsted Grotesk,system-ui,sans-serif;display:flex;flex-direction:column;justify-content:space-between;gap:24px;min-height:136px;width:220px;box-sizing:border-box;padding:16px;border-radius:24px;background:var(--carta-blush);text-decoration:none}.ds-tile-n{font-size:14px;font-weight:600;font-variant-numeric:tabular-nums}.ds-tile-name{display:block;font-family:Gloock,Georgia,serif;font-weight:400;font-size:30px;line-height:1.05}.ds-tile-count{display:block;margin-top:6px;font-size:14px;font-weight:500}.ds-tile:focus-visible{outline:2px solid var(--carta-terra);outline-offset:3px}"
    },
    {
      "name": "Banda de sección",
      "kind": "custom",
      "refersTo": "section-band",
      "description": "Banda pegajosa con el tono de su celda.",
      "html": "<div class=\"ds-band\"><span class=\"ds-band-n\">02</span><h2 class=\"ds-band-h\">Principales</h2><p class=\"ds-band-c\">9 platos</p></div>",
      "css": ".ds-band{--carta-green:#3d5f48;font-family:Schibsted Grotesk,system-ui,sans-serif;display:flex;align-items:baseline;gap:12px;padding:10px 16px;border-radius:16px;background:var(--carta-green);color:#fff}.ds-band-n{font-size:14px;font-weight:600;font-variant-numeric:tabular-nums}.ds-band-h{margin:0;font-family:Gloock,Georgia,serif;font-weight:400;font-size:32px;line-height:1}.ds-band-c{margin:0 0 0 auto;font-size:14px;font-weight:500}"
    },
    {
      "name": "Card de plato sin foto",
      "kind": "card",
      "refersTo": "dish-card-sin-foto",
      "description": "Card tipográfica sobre arena con inicial editorial.",
      "html": "<article class=\"ds-dish\"><span class=\"ds-dish-i\" aria-hidden=\"true\">M</span><h3 class=\"ds-dish-n\">Milanesa napolitana</h3><p class=\"ds-dish-p\">$ 12.500</p><p class=\"ds-dish-d\">Con jamón, salsa y queso gratinado.</p></article>",
      "css": ".ds-dish{--ink:#2a2622;--muted:#655d52;--carta-terra:#a43f22;--carta-sand:#e8dcc2;color:var(--ink);font-family:Schibsted Grotesk,system-ui,sans-serif;position:relative;overflow:hidden;width:240px;box-sizing:border-box;padding:16px;border-radius:24px;background:var(--carta-sand);box-shadow:inset 0 0 0 1px rgb(42 38 34/.15)}.ds-dish-i{position:absolute;right:-4px;bottom:-16px;font-family:Gloock,Georgia,serif;font-size:112px;line-height:1;color:rgb(61 95 72/.1)}.ds-dish-n{position:relative;margin:0;font-family:Gloock,Georgia,serif;font-weight:400;font-size:21px;line-height:1.05}.ds-dish-p{position:relative;margin:8px 0 0;font-size:16px;font-weight:600;color:var(--carta-terra);font-variant-numeric:tabular-nums}.ds-dish-d{position:relative;margin:8px 0 0;font-size:14px;line-height:1.6;color:var(--muted)}"
    },
    {
      "name": "Chip de categoría",
      "kind": "chip",
      "refersTo": "chip-category",
      "description": "Chip de la barra fija; el activo va en verde.",
      "html": "<a class=\"ds-chip\" href=\"#\">Postres</a> <a class=\"ds-chip\" aria-current=\"true\" href=\"#\">Pastas</a>",
      "css": ".ds-chip{--ink:#2a2622;--carta-green:#3d5f48;--carta-blush:#f3d2c6;--carta-sand:#e8dcc2;color:var(--ink);font-family:Schibsted Grotesk,system-ui,sans-serif;display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:9999px;background:var(--carta-blush);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}.ds-chip:hover{background:var(--carta-sand)}.ds-chip[aria-current=true]{background:var(--carta-green);color:#fff}.ds-chip:focus-visible{outline:2px solid var(--carta-green);outline-offset:2px}"
    },
    {
      "name": "Chip de dieta",
      "kind": "chip",
      "refersTo": "chip-dieta",
      "description": "Filtro dietario con estado presionado.",
      "html": "<button class=\"ds-diet\" type=\"button\">Vegano</button> <button class=\"ds-diet\" type=\"button\" aria-pressed=\"true\">Sin TACC</button>",
      "css": ".ds-diet{--carta-green:#3d5f48;--carta-sand:#e8dcc2;font-family:Schibsted Grotesk,system-ui,sans-serif;min-height:44px;padding:0 16px;border-radius:9999px;border:1px solid var(--carta-green);background:transparent;color:var(--carta-green);font-size:14px;font-weight:500}.ds-diet:hover{background:var(--carta-sand)}.ds-diet[aria-pressed=true]{background:var(--carta-green);color:#fff}.ds-diet:focus-visible{outline:2px solid var(--carta-green);outline-offset:2px}"
    },
    {
      "name": "Buscador",
      "kind": "input",
      "refersTo": "buscador",
      "description": "Campo de búsqueda de platos.",
      "html": "<label class=\"ds-l\" for=\"ds-s\">Buscar platos</label><input id=\"ds-s\" class=\"ds-in\" type=\"search\" placeholder=\"Nombre o descripción\">",
      "css": ".ds-l{--ink:#2a2622;color:var(--ink);font-family:Schibsted Grotesk,system-ui,sans-serif;display:block;font-size:16px;font-weight:500}.ds-in{--carta-green:#3d5f48;font-family:Schibsted Grotesk,system-ui,sans-serif;color:#2a2622;display:block;margin-top:8px;width:100%;box-sizing:border-box;min-height:48px;padding:0 16px;border:1px solid rgb(42 38 34/.6);border-radius:8px;background:transparent;font-size:16px}.ds-in:focus-visible{outline:2px solid var(--carta-green);outline-offset:2px}"
    },
    {
      "name": "Dock de llamado",
      "kind": "nav",
      "refersTo": "dock-llamar",
      "description": "Dock flotante con dos celdas; única sombra del sistema.",
      "html": "<div class=\"ds-dock\"><button class=\"ds-d1\" type=\"button\">Llamar al mozo</button><button class=\"ds-d2\" type=\"button\">Pedir la cuenta</button></div>",
      "css": ".ds-dock{--ink:#2a2622;--carta-green:#3d5f48;--carta-blush:#f3d2c6;font-family:Schibsted Grotesk,system-ui,sans-serif;display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:420px;padding:8px;border-radius:28px;background:rgb(244 239 228/.95);box-shadow:0 10px 28px -10px rgb(0 0 0/.4),inset 0 0 0 1px rgb(42 38 34/.15)}.ds-d1,.ds-d2{min-height:56px;border:0;border-radius:24px;font:inherit;font-size:16px;font-weight:600}.ds-d1{background:var(--carta-green);color:#fff}.ds-d2{background:var(--carta-blush);color:var(--ink)}.ds-d1:focus-visible,.ds-d2:focus-visible{outline:2px solid var(--carta-green);outline-offset:2px}"
    },
    {
      "name": "Riel del panel",
      "kind": "nav",
      "refersTo": "panel-rail",
      "description": "Riel verde profundo desde lg: nombre en display, insignia de rol, secciones agrupadas y cuenta al pie.",
      "html": "<aside class=\"ds-rail\"><a class=\"ds-rail-n\" href=\"#\">La Parrilla</a><span class=\"ds-rail-r\">Dueño</span><span class=\"ds-rail-g\">Tu local</span><a class=\"ds-rail-l\" href=\"#\" aria-current=\"page\">Resumen</a><a class=\"ds-rail-l\" href=\"#\">Carta</a><a class=\"ds-rail-l ds-rail-acc\" href=\"#\">Mi cuenta</a></aside>",
      "css": ".ds-rail{--porcelain:#f4efe4;--ink:#2a2622;--carta-green-deep:#2f4a39;font-family:Schibsted Grotesk,system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;box-sizing:border-box;width:272px;padding:20px;background:var(--carta-green-deep);color:#fff}.ds-rail-n{font-family:Gloock,Georgia,serif;font-weight:400;font-size:32px;line-height:1;color:#fff;text-decoration:none;margin-bottom:8px}.ds-rail-r{align-self:flex-start;padding:2px 10px;border-radius:9999px;background:rgb(255 255 255/.15);font-size:14px;font-weight:500}.ds-rail-g{padding:16px 12px 4px;font-size:13px;font-weight:600;color:rgb(255 255 255/.75)}.ds-rail-l{display:flex;align-items:center;min-height:44px;padding:0 12px;border-radius:16px;color:#fff;font-size:15px;font-weight:500;text-decoration:none}.ds-rail-l:hover{background:rgb(255 255 255/.1)}.ds-rail-l[aria-current=page]{background:var(--porcelain);color:var(--ink)}.ds-rail-acc{margin-top:16px}.ds-rail-l:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Chip de navegación",
      "kind": "chip",
      "refersTo": "nav-chip",
      "description": "Chip de sección en celular: rosa en reposo, verde la sección actual.",
      "html": "<a class=\"ds-nc\" href=\"#\">Carta</a> <a class=\"ds-nc\" href=\"#\" aria-current=\"page\">Resumen</a>",
      "css": ".ds-nc{--ink:#2a2622;--carta-green:#3d5f48;--carta-blush:#f3d2c6;--carta-sand:#e8dcc2;font-family:Schibsted Grotesk,system-ui,sans-serif;display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border-radius:9999px;background:var(--carta-blush);color:var(--ink);font-size:15px;font-weight:500;white-space:nowrap;text-decoration:none;transition:background-color 180ms cubic-bezier(.22,1,.36,1),color 180ms cubic-bezier(.22,1,.36,1)}.ds-nc:hover{background:var(--carta-sand)}.ds-nc[aria-current=page]{background:var(--carta-green);color:#fff}.ds-nc:focus-visible{outline:2px solid var(--carta-green);outline-offset:2px}"
    },
    {
      "name": "Celda del panel",
      "kind": "card",
      "refersTo": "panel-cell",
      "description": "Superficie de trabajo: 24 px, filete interior, sin sombra; la lista dentro queda plana.",
      "html": "<section class=\"ds-cell\"><h2 class=\"ds-cell-h\">Sucursales</h2><ul class=\"ds-cell-l\"><li>Centro<span>Activa</span></li><li>Norte<span>Activa</span></li></ul></section>",
      "css": ".ds-cell{--ink:#2a2622;--porcelain:#f4efe4;font-family:Schibsted Grotesk,system-ui,sans-serif;box-sizing:border-box;width:320px;padding:24px;border-radius:24px;background:color-mix(in srgb,var(--porcelain) 45%,white);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--ink) 15%,transparent);color:var(--ink)}.ds-cell-h{margin:0 0 12px;font-family:Gloock,Georgia,serif;font-weight:400;font-size:28px;line-height:1.05;letter-spacing:-.005em}.ds-cell-l{margin:0;padding:0;list-style:none;border-top:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}.ds-cell-l li{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}.ds-cell-l li:last-child{border-bottom:0}"
    },
    {
      "name": "Insignia de estado",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Píldora de estado o rol; el estado va siempre en texto.",
      "html": "<span class=\"ds-pill\">Dueño</span> <span class=\"ds-pill ds-pill-ok\">Listo</span> <span class=\"ds-pill ds-pill-todo\">Para hacer</span>",
      "css": ".ds-pill{--ink:#2a2622;--carta-green:#3d5f48;--carta-blush:#f3d2c6;font-family:Schibsted Grotesk,system-ui,sans-serif;display:inline-flex;align-items:center;padding:2px 10px;border-radius:9999px;background:var(--carta-blush);color:var(--ink);font-size:14px;font-weight:500}.ds-pill-ok{background:var(--carta-green);color:#fff}.ds-pill-todo{background:rgb(255 255 255/.7)}"
    },
    {
      "name": "Botón primario del panel",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Píldora en el acento del local; una por vista.",
      "html": "<button class=\"ds-bp\" type=\"button\">Guardar cambios</button>",
      "css": ".ds-bp{--cobalt:#3d5f48;--carta-green-deep:#2f4a39;font-family:Schibsted Grotesk,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 20px;border:0;border-radius:9999px;background:var(--cobalt);color:#fff;font-size:16px;font-weight:500}.ds-bp:hover{background:var(--carta-green-deep)}.ds-bp:disabled{opacity:.6}.ds-bp:focus-visible{outline:2px solid var(--cobalt);outline-offset:2px}"
    },
    {
      "name": "Botón secundario del panel",
      "kind": "button",
      "refersTo": "button-secondary",
