{
  "name": "ucomenu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,studio,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "dev:crear-dueno": "node tools/crear-dueno.mjs",
    "revision:codex": "node tools/revision-codex.mjs",
    "prod:check": "node tools/verificar-produccion.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test:e2e:full": "next build && playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@11.19.0"
}
