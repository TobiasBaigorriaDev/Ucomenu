# Copiá este archivo a .env.local y completalo. .env.local NO se versiona.
#
# Con Supabase local (pnpm db:start), los valores salen de:  pnpm exec supabase status -o env
#   NEXT_PUBLIC_SUPABASE_URL             <- API_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- PUBLISHABLE_KEY (o ANON_KEY si tu CLI no la muestra)
#
# Estas variables llegan al navegador (prefijo NEXT_PUBLIC_): solo clave PÚBLICA.
# La clave de servicio / secret NUNCA va acá ni en ninguna variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección pública de la app (opcional en desarrollo). Es la base de los QR de las mesas: cada QR codifica
# {NEXT_PUBLIC_SITE_URL}/t/{token}. Sin ella se usa el host del pedido al imprimir, que sirve en local pero en
# producción conviene fijarla al dominio definitivo (si no, el QR impreso apunta al dominio desde el que se abrió el panel).
# Ejemplo local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Secreto de SERVIDOR para armar el identificador de cliente del llamado al mozo (HMAC-SHA256 de la IP del comensal,
# nunca la IP en claro). Sin el prefijo NEXT_PUBLIC_. Opcional en desarrollo: si falta se usa uno efímero por proceso
# (el límite por cliente solo vale dentro de cada proceso). En producción conviene fijarlo a un valor largo y aleatorio
# (por ejemplo `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`). No da acceso a datos.
# También firma el «ticket de visita» (la pestaña de /t/{token} vence a las 3 horas): ahí un ticket que no se puede verificar
# bloquea al comensal, así que EN PRODUCCIÓN ES OBLIGATORIO (con el secreto efímero los tickets no valdrían entre instancias
# ni tras un reinicio).
WAITER_CALL_CLIENT_SECRET=

# Email de contacto que muestra la política de privacidad para ejercer los derechos sobre los datos personales
# (Ley 25.326). Es público (NEXT_PUBLIC_). Sin definir, el texto indica contactar al equipo sin dar una dirección:
# EN PRODUCCIÓN DEFINILO (es parte del checklist de «Salida a producción»).
NEXT_PUBLIC_CONTACT_EMAIL=

# Clave de servicio (service_role / SECRET_KEY): SOLO servidor. Sin el prefijo NEXT_PUBLIC_.
# La usa la gestión de personal del panel (alta, baja y contraseñas del equipo) y los scripts de tools/.
# Con `pnpm dev` va en .env.local; las pruebas (RLS y E2E) la leen de .env.test.local.
# Con Supabase local sale de:  pnpm exec supabase status -o env   (SERVICE_ROLE_KEY o SECRET_KEY)
# NUNCA la subas a Git, ni la pongas en una variable NEXT_PUBLIC_*, ni la uses contra un proyecto remoto
# sin aprobación explícita.
SUPABASE_SERVICE_ROLE_KEY=

# Aviso de llamados con la pestaña cerrada (Web Push; ADR 0020). Genera el par con `pnpm push:claves` (cada entorno el suyo).
# Sin estas variables el aviso queda apagado y la sala sigue funcionando por sondeo. La privada es un SECRETO de servidor
# (sin NEXT_PUBLIC_, no va a Git ni a la imagen; en Fly: `fly secrets set`). La pública llega al navegador por la página de la sala.
# VAPID_SUBJECT es un contacto (`mailto:` o `https:`); si falta se usa NEXT_PUBLIC_CONTACT_EMAIL. Cambiar el par invalida las
# suscripciones: cada dispositivo vuelve a activar el aviso.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Videos del feed (Mux Video; ADR 0031, ficha videos-mux-parte-b). Los tres son SECRETOS de servidor (sin NEXT_PUBLIC_, no van a Git
# ni a la imagen; en Fly: `fly secrets set`). Cada entorno de Mux (Development para staging, Production) tiene los suyos:
#   MUX_TOKEN_ID / MUX_TOKEN_SECRET  Settings → API Access Tokens, con permisos de Mux Video (lectura y escritura). El secreto se
#                                    ve una sola vez.
#   MUX_WEBHOOK_SECRET               Settings → Webhooks → el webhook de https://<dominio>/api/mux/webhook (signing secret).
# Sin los dos primeros la pantalla de videos explica que la subida no está configurada; sin el tercero el webhook responde 503 y
# ningún video sale de «Procesando».
# MUX_API_URL solo sirve para apuntar a un servidor de pruebas DE ESTA MÁQUINA (localhost / 127.0.0.1): cualquier otro valor se ignora.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
