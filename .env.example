# Copiá este archivo a .env.local y completalo. .env.local NO se versiona.
#
# Con Supabase local (pnpm db:start), los valores salen de:  pnpm exec supabase status -o env
#   NEXT_PUBLIC_SUPABASE_URL             <- API_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- PUBLISHABLE_KEY (o ANON_KEY si tu CLI no la muestra)
#
# Estas variables llegan al navegador (prefijo NEXT_PUBLIC_): solo clave PÚBLICA.
# La clave de servicio / secret NUNCA va acá ni en ninguna variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dirección pública de la app (opcional en desarrollo). Es la base de los QR de las mesas: cada QR codifica
# {NEXT_PUBLIC_SITE_URL}/t/{token}. Sin ella se usa el host del pedido al imprimir, que sirve en local pero en
# producción conviene fijarla al dominio definitivo (si no, el QR impreso apunta al dominio desde el que se abrió el panel).
# Ejemplo local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Secreto de SERVIDOR para armar el identificador de cliente del llamado al mozo (HMAC-SHA256 de la IP del comensal,
# nunca la IP en claro). Sin el prefijo NEXT_PUBLIC_. Opcional en desarrollo: si falta se usa uno efímero por proceso
# (el límite por cliente solo vale dentro de cada proceso). En producción conviene fijarlo a un valor largo y aleatorio
# (por ejemplo `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`). No da acceso a datos.
WAITER_CALL_CLIENT_SECRET=

# Clave de servicio (service_role / SECRET_KEY): SOLO servidor. Sin el prefijo NEXT_PUBLIC_.
# La usa la gestión de personal del panel (alta, baja y contraseñas del equipo) y los scripts de tools/.
# Con `pnpm dev` va en .env.local; las pruebas (RLS y E2E) la leen de .env.test.local.
# Con Supabase local sale de:  pnpm exec supabase status -o env   (SERVICE_ROLE_KEY o SECRET_KEY)
# NUNCA la subas a Git, ni la pongas en una variable NEXT_PUBLIC_*, ni la uses contra un proyecto remoto
# sin aprobación explícita.
SUPABASE_SERVICE_ROLE_KEY=
